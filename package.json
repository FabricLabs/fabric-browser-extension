    "browserify-zlib": "=0.2.0",
    "buffer": "=6.0.3",
    "c8": "=10.1.3",
    "clean-webpack-plugin": "=4.0.0",
    "copy-webpack-plugin": "=12.0.2",
    "crypto-browserify": "=3.12.1",
    "css-loader": "=6.10.0",
    "file-loader": "=6.2.0",
    "gulp": "=4.0.2",
    "gulp-autoprefixer": "=8.0.0",
    "gulp-chmod": "=3.0.0",
    "gulp-clean-css": "=4.3.0",
    "gulp-concat": "=2.6.1",
    "gulp-concat-css": "=3.1.0",
    "gulp-dedupe": "=0.0.2",
    "gulp-flatten": "=0.4.0",
