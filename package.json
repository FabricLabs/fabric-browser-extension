    "ts-node": "=10.9.2",
    "typescript": "^5.3.3",
    "url": "=0.11.4",
    "util": "=0.12.5",
    "vm-browserify": "=1.1.2",
    "webpack": "=5.90.3",
    "webpack-cli": "=5.1.4",
    "webpack-dev-server": "=4.15.1",
