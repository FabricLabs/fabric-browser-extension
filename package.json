{
  "name": "@fabric/passport",
  "description": "Log in to websites with Fabric",
  "version": "0.1.0",
  "main": "src/UIElements/popup/index.tsx",
  "private": true,
  "author": "Fabric Labs",
  "license": "MIT",
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "build:dev": "NODE_ENV=development npm run build",
    "build:prod": "NODE_ENV=production npm run build",
    "build:semantic": "cd libraries/semantic && npx gulp build && cd ../..",
    "bundle": "npm run build:prod && webpack --config webpack.config.js --mode production --output-path dist",
    "package": "npm run bundle && node scripts/zip-dist.cjs",
    "coverage": "c8 npm run test:coverage-suite",
    "coverage:baseline": "npm run coverage && node scripts/coverage-baseline.js",
    "make:coverage": "npm run coverage && c8 report --reporter html",
    "test:coverage-suite": "npm run test:unit && npm run test:extension",
    "test:ui": "FABRIC_ACTION_DEBUG_URL=http://127.0.0.1:3044/api/endpoint npm run build && playwright test",
    "test:ui:mesh-remote": "FABRIC_ACTION_DEBUG_URL=http://127.0.0.1:3044/api/endpoint npm run build && env FABRIC_HUB_BASE_URL=${FABRIC_HUB_BASE_URL:-http://127.0.0.1:8080} npx playwright test tests/ui/hub-remote-mesh-bridge.spec.ts",
    "test:ui:release-gate": "npm run build && node scripts/run-ui-release-gate.cjs",
    "test:all": "npm run test && npm run test:ui",
    "ci": "npm run test:all",
    "report:install": "rm -rf node_modules && echo \"\n\" > package-lock.json && echo \"$ npm i\" > reports/install.log && npm i >> reports/install.log",
    "report:todo": "grep --exclude-dir=.git --exclude-dir=_book --exclude-dir=assets --exclude-dir=node_modules --exclude-dir=reports --exclude-dir=coverage --exclude-dir=docs -rEI \"TODO|FIXME\" --exclude-dir=dist . > reports/TODO.txt",
    "review:coverage": "npm run make:coverage && http-server -p 8000 coverage",
    "start": "webpack serve --config webpack.config.js",
    "serve:test": "npm run build && node scripts/local-test-server.js",
    "test:unit": "NODE_ENV=test mocha tests/bech32m.test.ts tests/bip32.test.ts tests/identityOutbandValue.unit.ts tests/fabricHttp402.unit.ts",
    "test:extension": "NODE_ENV=test FABRIC_ACTION_DEBUG_URL=http://127.0.0.1:3044/api/endpoint npx playwright install chromium && npm run build && NODE_ENV=test mocha tests/extension.test.ts",
    "playwright:install": "playwright install chromium",
    "test:local": "npm run serve:test",
    "test": "npm run test:unit && npm run test:extension"
  },
  "dependencies": {
    "@bitcoinerlab/secp256k1": "=1.2.0",
    "@fabric/core": "FabricLabs/fabric#feature/v0.1.0-RC1",
    "@fabric/http": "FabricLabs/fabric-http#feature/v0.1.0-RC1",
    "bip32": "=5.0.0-rc.0",
    "bip39": "=3.1.0",
    "bitcoinjs-lib": "=6.1.7",
    "process": "=0.11.10",
    "react": "=18.2.0",
    "react-dom": "=18.2.0",
    "semantic-ui-css": "=2.5.0",
    "semantic-ui-react": "=2.1.5",
    "tiny-secp256k1": "=2.2.4"
  },
  "devDependencies": {
    "@babel/core": "=7.23.9",
    "@babel/preset-env": "=7.23.9",
    "@babel/preset-react": "=7.23.3",
    "@babel/preset-typescript": "=7.23.3",
    "@playwright/test": "=1.53.1",
    "@types/chrome": "=0.0.323",
    "@types/mocha": "=10.0.10",
    "@types/node": "^24.0.3",
    "@types/react": "=18.2.55",
    "@types/react-dom": "=18.2.19",
    "@types/sinon": "=17.0.4",
    "assert": "=2.1.0",
